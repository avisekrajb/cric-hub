PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=bethub

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
ADMIN_NAME=Bethub Admin
ADMIN_EMAIL=admin@bethub.com
ADMIN_PASSWORD=change-me

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Defaults only — admins can change every value live from Admin → Settings.
MAX_LIVE_MATCHES=10
MAX_CONCURRENT_RECORDINGS=5
MAX_VIDEO_MB=200
MAX_IMAGE_MB=50
MAX_LIVE_HOURS=4

# LiveKit SFU — required for the LiveKit broadcast + playback modes.
# Point LIVEKIT_URL at your LiveKit Cloud project (wss://…) or a self-hosted SFU.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=6h

TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
